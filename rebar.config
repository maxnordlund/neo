{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

{deps, []}.

{post_hooks, [
    {edoc, "./script/generate-doc-chunks.escript neo"}
]}.

{project_plugins, [
    erlfmt,
    rebar3_ex_doc,
    rebar3_lint
]}.

{erlfmt, [
    write,
    {print_width, 88}
]}.

%% https://www.erlang.org/doc/man/edoc.html#run-2
{edoc_opts, [
    {preprocess, true},
    {hidden, true},
    {private, true},
    {todo, true}
]}.

{ex_doc, [
    {extras, ["README.md", "LICENSE"]},
    {main, "README.md"},
    {source_ref, "master"},
    {deps, [
        {eon, "https://github.com/kivra/eon"}
    ]},
    {skip_code_autolink_to, [
        <<"eon">>
    ]}
]}.

%% https://www.rebar3.org/docs/configuration/configuration/#xref
%% https://www.erlang.org/doc/man/xref.html#analyze-3
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    %% exports_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{shell, [
    %% {config, "config/sys.config"}
]}.

{profiles, [
    {docs, [
        {deps, [
        ]}
    ]}
]}.
